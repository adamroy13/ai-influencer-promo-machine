{
  "rewrites": [
    { "source": "/api/hf/(.*)", "destination": "/api/hfproxy?__hfpath=$1" },
    { "source": "/api/runway/upload-asset", "destination": "/api/runway-asset" },
    { "source": "/api/runway/(.*)", "destination": "/api/runway?__path=$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
